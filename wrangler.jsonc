{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nicolasruiz-portfolio",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "nicolasruiz.net", "custom_domain": true },
    { "pattern": "www.nicolasruiz.net", "custom_domain": true }
  ],
  "assets": {
    "directory": "./.assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
