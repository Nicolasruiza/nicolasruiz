{
  "name": "nicolasruiz-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "test": "node scripts/build-assets.mjs && node --test tests/*.test.mjs",
    "test:browser": "node scripts/build-assets.mjs && node tests/browser.mjs",
    "dev": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.151.0"
  }
}
